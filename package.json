{
	"name": "@jonahsnider/benchmark",
	"version": "6.0.1",
	"bugs": {
		"url": "https://github.com/jonahsnider/benchmark/issues"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/benchmark.git"
	},
	"files": [
		"dist",
		"!dist/{test,examples}"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"docs": "typedoc",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"knip": "knip",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"prepare": "vp config",
		"test": "vp test",
		"test:coverage": "vp test --coverage",
		"validate-api": "api-extractor run",
		"validate-api:local": "api-extractor run --local --verbose"
	},
	"dependencies": {
		"@jonahsnider/util": "13.0.0",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "7.59.0",
		"@tsconfig/node24": "24.0.5",
		"@tsconfig/recommended": "1.0.13",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.11",
		"knip": "6.34.0",
		"typedoc": "0.28.20",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1",
		"vitest": "4.1.11"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "warn"
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "pnpm@12.3.4"
}
